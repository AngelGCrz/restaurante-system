# Puerto del agente
PRINT_AGENT_PORT=3000

# Seguridad local (opcional, solo si quieres token)
PRINT_AGENT_TOKEN=print
# Nombre exacto de la impresora USB en Windows
PRINT_AGENT_PRINTER="POSPrinter POS-80C"

# URL de tu Laravel en hosting compartido
API_URL=https://ricosabor.softsystemsr.com/kitchen

# Intervalo en segundos para revisar órdenes
PULL_INTERVAL=5

# Modo de impresión
PRINT_MODE=pull




